# Variables de entorno del sistema de monitoreo San Juan Sacatepéquez.
# Copiar este archivo como .env y cambiar los valores CAMBIAR_...
# El archivo .env nunca se sube a git porque contiene contraseñas.

# Zona horaria de los contenedores
TZ=America/Guatemala

# PostgreSQL: usuario administrador (solo para crear la base)
POSTGRES_DB=monitoreo
POSTGRES_USER=admin
POSTGRES_PASSWORD=CAMBIAR_POSTGRES

# PostgreSQL: usuario de la aplicación (lectura y escritura)
APP_DB_USER=app
APP_DB_PASSWORD=CAMBIAR_APP

# PostgreSQL: usuario de solo lectura para Grafana
GRAFANA_RO_PASSWORD=CAMBIAR_RO

# Grafana: usuario administrador de la interfaz web
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_GRAFANA

# Clave secreta para el HMAC-SHA256 de las placas (64 caracteres hex)
PLATE_HMAC_KEY=CAMBIAR_HMAC

# Correlador
CORRELATION_WINDOW_SECONDS=300
ACOUSTIC_MIN_PROBABILITY=0.7
SLO_LATENCIA_MS=2000
SCHOOL_HOURS=06:30-08:00,12:00-13:30
