{
  "uid": "bandeja-instituciones",
  "title": "4. Bandeja de instituciones",
  "description": "Alertas recibidas por cada institución externa (PNC, Bomberos, CONRED y aseguradora), según la tabla dispatches. Las más recientes primero.",
  "tags": [
    "monitoreo",
    "sjs",
    "instituciones"
  ],
  "timezone": "America/Guatemala",
  "refresh": "5s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": false,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "PNC (topic external.pnc), últimas 200",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 13
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-sjs"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT d.enviado_at AS \"Enviada\", a.alert_type AS \"Tipo\", z.zone_name AS \"Sector\", a.severity AS \"Severidad\", a.description AS \"Descripción\", d.resultado AS \"Resultado\" FROM dispatches d JOIN alerts a ON a.alert_id = d.alert_id JOIN zones z ON z.zone = a.zone WHERE d.destino = 'external.pnc' AND $__timeFilter(d.enviado_at) ORDER BY d.enviado_at DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Enviada"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tipo"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 175
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sector"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Resultado"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 45
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Severidad"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CRITICA": {
                        "color": "red",
                        "index": 0
                      },
                      "ALTA": {
                        "color": "orange",
                        "index": 1
                      },
                      "MEDIA": {
                        "color": "yellow",
                        "index": 2
                      },
                      "BAJA": {
                        "color": "blue",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
