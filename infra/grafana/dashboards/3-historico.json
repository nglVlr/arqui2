{
  "uid": "historico",
  "title": "3. Histórico (perfil full)",
  "description": "Búsqueda histórica de alertas en Elasticsearch y estadísticas calculadas por Airflow.",
  "tags": ["monitoreo", "sjs", "historico"],
  "timezone": "America/Guatemala",
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "schemaVersion": 41,
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "busqueda",
        "label": "Buscar alertas (sintaxis Lucene, ej. alertType:ROBO_EN_CURSO o zoneName:Quetzal)",
        "type": "textbox",
        "query": "*",
        "current": { "text": "*", "value": "*" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Alertas en el tiempo (Elasticsearch)",
      "gridPos": { "x": 0, "y": 0, "w": 16, "h": 8 },
      "datasource": { "type": "elasticsearch", "uid": "elastic-sjs" },
      "targets": [
        { "refId": "A", "query": "${busqueda:raw}", "timeField": "createdAt",
          "metrics": [ { "id": "1", "type": "count" } ],
          "bucketAggs": [ { "id": "2", "type": "date_histogram", "field": "createdAt", "settings": { "interval": "auto", "min_doc_count": "0" } } ] }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 70 }, "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "options": { "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Alertas por tipo (Elasticsearch)",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "elasticsearch", "uid": "elastic-sjs" },
      "targets": [
        { "refId": "A", "query": "${busqueda:raw}", "timeField": "createdAt",
          "metrics": [ { "id": "1", "type": "count" } ],
          "bucketAggs": [ { "id": "2", "type": "terms", "field": "alertType.keyword",
                            "settings": { "size": "10", "order": "desc", "orderBy": "_count", "min_doc_count": "1" } } ] }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "pieType": "donut", "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "values": ["value"] },
                   "reduceOptions": { "calcs": ["sum"], "fields": "", "values": true } }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Resultado de la búsqueda (Elasticsearch, últimas 200)",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 10 },
      "datasource": { "type": "elasticsearch", "uid": "elastic-sjs" },
      "targets": [
        { "refId": "A", "query": "${busqueda:raw}", "timeField": "createdAt",
          "metrics": [ { "id": "1", "type": "raw_data", "settings": { "size": "200" } } ],
          "bucketAggs": [] }
      ],
      "transformations": [
        { "id": "organize", "options": {
          "includeByName": { "createdAt": true, "alertType": true, "zoneName": true, "severity": true, "status": true, "description": true, "scenarioId": true },
          "indexByName": { "createdAt": 0, "alertType": 1, "zoneName": 2, "severity": 3, "status": 4, "description": 5, "scenarioId": 6 },
          "renameByName": { "createdAt": "Hora", "alertType": "Tipo", "zoneName": "Sector", "severity": "Severidad", "status": "Estado", "description": "Descripción", "scenarioId": "Escenario" } } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byName", "options": "Severidad" },
          "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "mappings", "value": [ { "type": "value", "options": {
              "CRITICA": { "color": "red", "index": 0 }, "ALTA": { "color": "orange", "index": 1 },
              "MEDIA": { "color": "yellow", "index": 2 }, "BAJA": { "color": "blue", "index": 3 } } } ] } ] } ] },
      "options": { "showHeader": true, "cellHeight": "sm", "sortBy": [ { "displayName": "Hora", "desc": true } ] }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Estadísticas diarias por sector, tipo y severidad (DAG reporte_diario)",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 10 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres-sjs" },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "editorMode": "code",
          "rawSql": "SELECT to_char(d.fecha, 'YYYY-MM-DD') AS \"Fecha\", z.zone_name AS \"Sector\", d.alert_type AS \"Tipo\", d.severity AS \"Severidad\", d.cantidad AS \"Cantidad\" FROM daily_stats d JOIN zones z ON z.zone = d.zone WHERE d.fecha >= ($__timeFrom())::date ORDER BY d.fecha DESC, d.cantidad DESC" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Falsos positivos por sector, últimas 24 h (DAG analisis_falsos_positivos, último cálculo)",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 10 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres-sjs" },
      "targets": [
        { "refId": "A", "format": "table", "rawQuery": true, "editorMode": "code",
          "rawSql": "SELECT z.zone_name AS \"Sector\", f.panicos_confirmados AS \"Pánicos confirmados\", f.panicos_no_confirmados AS \"Pánicos no confirmados\", 100 * f.proporcion_fp AS \"% falsos positivos\" FROM false_positive_stats f JOIN zones z ON z.zone = f.zone WHERE f.calculado_at = (SELECT max(calculado_at) FROM false_positive_stats) ORDER BY z.zone" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byName", "options": "% falsos positivos" },
          "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 0 }, { "id": "min", "value": 0 }, { "id": "max", "value": 100 },
            { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } },
            { "id": "color", "value": { "mode": "continuous-GrYlRd" } } ] } ] },
      "options": { "showHeader": true, "cellHeight": "sm" }
    }
  ]
}